{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "project",
      "displayName": "Configure VIHARA_BAND",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake_gcc/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "base"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default_config",
      "displayName": "Build VIHARA_BAND",
      "configurePreset": "project",
      "configuration": "base",
      "targets": ["VIHARA_BAND"]
    }
  ],
  "workflowPresets": [
    {
      "name": "project",
      "steps": [
        { "type": "configure", "name": "project" },
        { "type": "build", "name": "default_config" }
      ]
    }
  ]
}
