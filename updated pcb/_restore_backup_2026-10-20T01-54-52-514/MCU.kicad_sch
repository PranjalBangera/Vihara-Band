	(text "MEDICAL WEARABLE PATCH – DESIGN NOTES\n\n• EFR32BG22 BLE MCU, 3.0 V supply\n• 2.4 GHz RF with Johanson antenna and matching network\n• BMA400 accelerometer via I²C\n• IS25LP064A 8 MB external SPI Flash\n• MCP73831 Li-Ion charging + TLV73330 3.0 V LDO\n• SWD interface provided for programming/debugging\n• RGB status LED with 330 Ω current-limiting resistors\n• Place decoupling capacitors close to IC power pins\n• Keep RF and crystal traces short; maintain proper antenna clearance"
		(exclude_from_sim no)
		(at 13.462 183.388 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1bce32cc-5232-4b14-a4a5-bcc6ff203d62")
	)
